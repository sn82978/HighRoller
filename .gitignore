.claude/

__pycache__/
*.pyc
.DS_Store

# Intermediate fetch caches — regenerable, and large (~70MB+).
data/cache/

# CSV mirrors of the parquet datasets. Identical content, ~20x the bytes
# (~500MB vs ~25MB). Regenerate with:
#   python data/fetch_btc_updown_15m.py --build-only --format csv
#   python data/fetch_btc_updown_15m_trades.py --build-only --format csv
data/polymarket/**/*.csv

# shreya
.venv
*.npy
btc_updown_15m_candles_15s
btc_updown_15m_minute
btc_updown_15m_ticks
QLearning/data

# Per-market backtest rows. One line per (strategy, market) -- large, and
# purely intermediate: comparison.csv and RESULTS.md are scored off them.
# Regenerate with the commands in FIGURES.md.
strategies/output/
BaselineModels/output/
QLearning/output/

# comparison.csv, comparison_spread.csv and comparison_figs/ are NOT ignored.
# They are the headline four-way result the writeup cites, they are small
# (~350KB all told), and a reader who clones this repo should not have to run
# three tracks and a 30-seed sweep to see the table the paper is about. Same
# reason figs/ and QLearning/figs/ are committed.